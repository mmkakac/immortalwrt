--- a/drivers/net/wireless/ath/wcn36xx/main.c
+++ b/drivers/net/wireless/ath/wcn36xx/main.c
@@ -1455,6 +1455,13 @@ static int wcn36xx_init_ieee80211(struct wcn36xx *wcn)
 	wcn->hw->wiphy->bands[NL80211_BAND_2GHZ] = &wcn_band_2ghz;
 	if (wcn->rf_id != RF_IRIS_WCN3620)
 		wcn->hw->wiphy->bands[NL80211_BAND_5GHZ] = &wcn_band_5ghz;
+
+	/* 2.4GHz: strip 40MHz HT capability, force 20MHz-only at driver level */
+	wcn->hw->wiphy->bands[NL80211_BAND_2GHZ]->ht_cap.cap &=
+		~(IEEE80211_HT_CAP_SUP_WIDTH_20_40 |
+		  IEEE80211_HT_CAP_SGI_40 |
+		  IEEE80211_HT_CAP_DSSSCCK40);
 
 	if (wcn->rf_id == RF_IRIS_WCN3680)
 		wcn36xx_set_ieee80211_vht_caps(&wcn_band_5ghz.vht_cap);
